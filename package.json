{
  "name": "@console-chaos/racing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cars": "node tools/check-cars.mjs",
    "prepare:cars": "node tools/prepare-cars.mjs",
    "build:minimap": "tsx tools/build-minimap.mjs",
    "build:track": "tsx tools/build-track-mesh.mjs",
    "build:paint": "tsx tools/build-car-paint.mjs",
    "build:road": "tsx tools/build-road-texture.mjs",
    "build:backdrop": "tsx tools/build-backdrop.mjs",
    "build:sprites": "tsx tools/build-car-sprites.mjs",
    "build:skyline": "tsx tools/build-skyline.mjs",
    "build:font": "tsx tools/build-font-atlas.mjs",
    "build:logo": "tsx tools/build-title-logo.mjs",
    "build:gauge": "tsx tools/build-gauge.mjs",
    "build:cockpit": "tsx tools/build-cockpit.mjs",
    "build:assets": "npm run build:minimap && npm run build:track && npm run build:paint && npm run build:road && npm run build:backdrop && npm run build:sprites && npm run build:skyline && npm run build:font && npm run build:logo && npm run build:gauge && npm run build:cockpit"
  },
  "dependencies": {
    "@console-chaos/engine": "file:reference/console-chaos-engine-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
